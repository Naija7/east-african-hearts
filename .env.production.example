# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in with real values
# NEVER commit .env to Git!

# Database Configuration (Railway provides these)
DB_HOST=your-railway-mysql-host.railway.app
DB_USER=root
DB_PASSWORD=your-secure-password-here
DB_NAME=datingdb

# Application Configuration
FLASK_SECRET_KEY=your-32-char-hex-secret-key-here
FLASK_ENV=production
FLASK_DEBUG=False

# Admin Credentials (use manage_admin.py to create admin after deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here

# Email Configuration (Gmail Example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here

# App URL (update with your Railway domain)
APP_URL=https://your-app.railway.app

# Security Settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
